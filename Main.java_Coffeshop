// COBRAR VENTA
// ==========================================

private void cobrarVenta() {

    if (turnoFinalizado) return;

    if (carrito.isEmpty()) {

        JOptionPane.showMessageDialog(
                this,
                "Primero agrega productos al pedido."
        );

        return;
    }

    long recibido;

    try {

        recibido = convertirDinero(
                txtRecibido.getText()
        );

    } catch (Exception e) {

        JOptionPane.showMessageDialog(
                this,
                "Ingresa un valor válido. Ejemplo: 10.00"
        );

        return;
    }

    if (recibido < totalActual) {

        JOptionPane.showMessageDialog(
                this,
                "El dinero recibido no alcanza."
        );

        return;
    }

    // COMPROBAR INVENTARIO
    for (Map.Entry<Producto, Integer> entrada :
            carrito.entrySet()) {

        if (entrada.getValue() > entrada.getKey().stock) {

            JOptionPane.showMessageDialog(
                    this,
                    "Stock insuficiente: " +
                            entrada.getKey().nombre
            );

            return;
        }
    }

    String vendedor = pedidoEnAtencion != null
            ? pedidoEnAtencion.empleadoAsignado
            : (String) cmbVendedor.getSelectedItem();

    long total = totalActual;
    long cambio = recibido - total;

    // DESCONTAR STOCK
    for (Map.Entry<Producto, Integer> entrada :
            carrito.entrySet()) {

        entrada.getKey().stock -= entrada.getValue();
    }

    // GUARDAR DETALLE DE LA VENTA
    Map<Producto, Integer> detalleVenta =
            new LinkedHashMap<>(carrito);

    int numeroFactura = historial.size() + 1;
    String fechaVenta = LocalDateTime.now().format(FORMATO_FECHA);
    String clienteVenta = pedidoEnAtencion == null
            ? "" : pedidoEnAtencion.nombreCliente;

    Venta venta = new Venta(
            numeroFactura,
            fechaVenta,
            vendedor,
            clienteVenta,
            total,
            recibido,
            cambio,
            detalleVenta
    );

    historial.offer(venta);
    try {
        exportarVentaCSV(venta);
    } catch (IOException ex) {
        JOptionPane.showMessageDialog(this,
                "La venta se guardó en el sistema, pero no se pudo actualizar "
                        + "el Excel/CSV: " + ex.getMessage(),
                "Aviso de reporte", JOptionPane.WARNING_MESSAGE);
    }
    guardarFacturaTexto(venta);

    // ACTUALIZAR ESTADISTICAS
    ventasPorVendedor.put(
            vendedor,
            ventasPorVendedor.get(vendedor) + 1
    );

    dineroPorVendedor.put(
            vendedor,
            dineroPorVendedor.get(vendedor) + total
    );

    // Persistir la venta antes de generar los archivos externos.
    guardarDatos();

    mostrarFactura(
            vendedor,
            total,
            recibido,
            cambio
    );

    carrito.clear();
    txtRecibido.setText("");
    pedidoEnAtencion = null;
    actualizarEtiquetaAtencion();

    actualizarCarrito();
    mostrarProductos();
    guardarDatos();
}


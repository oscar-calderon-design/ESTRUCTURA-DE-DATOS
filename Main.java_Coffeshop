// ==========================================
// CANCELAR PEDIDO
// ==========================================

private void cancelarPedido() {

    if (carrito.isEmpty() && pedidoEnAtencion == null) {
    JOptionPane.showMessageDialog(
            this,
            "No hay ningún pedido para cancelar."
    );
    return;
}

    int respuesta = JOptionPane.showConfirmDialog(
            this,
            "¿Deseas cancelar el pedido actual?",
            "Cancelar pedido",
            JOptionPane.YES_NO_OPTION
    );

    if (respuesta == JOptionPane.YES_OPTION) {

        carrito.clear();
        txtRecibido.setText("");
        pedidoEnAtencion = null;
        actualizarEtiquetaAtencion();
        actualizarCarrito();
        guardarDatos();
    }
}

// ==========================================
// NUEVA VENTA
// ==========================================

private void nuevaVenta() {

    if (turnoFinalizado) return;

    carrito.clear();
    txtRecibido.setText("");

    actualizarCarrito();
    mostrarProductos();
}

// ==========================================
// REPORTE FINAL DEL TURNO
// ==========================================

private void finalizarTurno() {

    if (turnoFinalizado) return;
if (pedidoEnAtencion != null || !colaLlegada.isEmpty()
            || !carrito.isEmpty()) {

        JOptionPane.showMessageDialog(this,
                "No puedes finalizar el turno mientras haya "
                        + "pedidos pendientes o productos en el carrito.");

        return;
    }
    int respuesta = JOptionPane.showConfirmDialog(
            this,
            "¿Deseas finalizar el turno y generar el reporte?",
            "Cierre de caja",
            JOptionPane.YES_NO_OPTION
    );

    if (respuesta != JOptionPane.YES_OPTION) {
        return;
    }

    StringBuilder reporte = new StringBuilder();

    reporte.append("       REPORTE DE COFFEESHOP\n");
    reporte.append("--------------------------------------\n");

    reporte.append("Ventas realizadas: ")
            .append(historial.size())
            .append("\n\n");

    long mayorDinero = -1;
    int mayorVentas = -1;

    for (String vendedor : vendedores) {

        int cantidad = ventasPorVendedor.get(vendedor);
        long dinero = dineroPorVendedor.get(vendedor);

        reporte.append(vendedor).append("\n");

        reporte.append("Cantidad de ventas: ")
                .append(cantidad).append("\n");

        reporte.append("Total vendido: ")
                .append(monedaUSD.format(dinero / 100.0))
                .append("\n\n");

        mayorDinero = Math.max(mayorDinero, dinero);
        mayorVentas = Math.max(mayorVentas, cantidad);
    }

    long totalGeneral = 0;

    for (Venta v : historial) {
        totalGeneral += v.totalCentavos;
    }

    reporte.append("--------------------------------------\n");

    reporte.append("TOTAL GENERAL: ")
            .append(monedaUSD.format(totalGeneral / 100.0))
            .append("\n\n");

    reporte.append("MAYOR VENTA EN DINERO:\n");

    for (String vendedor : vendedores) {

        if (dineroPorVendedor.get(vendedor) == mayorDinero) {

            reporte.append("- ")
                    .append(vendedor)
                    .append(": ")
                    .append(monedaUSD.format(mayorDinero / 100.0))
                    .append("\n");
        }
    }

    reporte.append("\nMAYOR NUMERO DE VENTAS:\n");

    for (String vendedor : vendedores) {

        if (ventasPorVendedor.get(vendedor) == mayorVentas) {

            reporte.append("- ")
                    .append(vendedor)
                    .append(": ")
                    .append(mayorVentas)
                    .append(" ventas\n");
        }
    }

    reporte.append("\nProductos diferentes: ")
            .append(productosUnicos.size());

    JTextArea area = new JTextArea(
            reporte.toString()
    );

    area.setEditable(false);
    area.setFont(
            new Font(Font.MONOSPACED, Font.BOLD, 13)
    );

    area.setForeground(Color.BLACK);
    area.setBackground(Color.WHITE);

    JOptionPane.showMessageDialog(
            this,
            new JScrollPane(area),
            "Reporte final del turno",
            JOptionPane.INFORMATION_MESSAGE
    );

    turnoFinalizado = true;
    guardarDatos();

    carrito.clear();
    pedidoEnAtencion = null;
    txtRecibido.setText("");

    actualizarEtiquetaAtencion();
    actualizarCarrito();
    mostrarProductos();
    guardarDatos();
}

// ==========================================
// SALIR DEL SISTEMA
// ==========================================

private void salirDelSistema() {

    int respuesta = JOptionPane.showConfirmDialog(
            this,
            "¿Estás seguro de que deseas cerrar COFFEESHOP?",
            "Salir del sistema",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.QUESTION_MESSAGE
    );

if (respuesta == JOptionPane.YES_OPTION) {
    guardarDatos();
    dispose();
    System.exit(0);
}
    }



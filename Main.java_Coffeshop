// ==========================================
// AGREGAR AL CARRITO
// ==========================================

private void agregarAlCarrito(Producto p) {

    if (turnoFinalizado) return;

    int cantidad = carrito.getOrDefault(p, 0);

    if (cantidad >= p.stock) {

        JOptionPane.showMessageDialog(
                this,
                "No hay suficientes unidades de " + p.nombre
        );

        return;
    }

    carrito.put(p, cantidad + 1);

    actualizarCarrito();
    guardarDatos();
}

// ==========================================
// ACTUALIZAR CARRITO
// ==========================================

private void actualizarCarrito() {

    panelCarrito.removeAll();

    long subtotal = 0;
    int unidades = 0;

    for (Map.Entry<Producto, Integer> entrada :
            carrito.entrySet()) {

        Producto p = entrada.getKey();
        int cantidad = entrada.getValue();

        long totalLinea =
                p.precioCentavos * cantidad;

        subtotal += totalLinea;
        unidades += cantidad;

        JPanel fila = new JPanel(
                new BorderLayout(5, 5)
        );

        fila.setMaximumSize(
                new Dimension(Integer.MAX_VALUE, 75)
        );

        fila.setBackground(BLANCO);
        fila.setBorder(
                new EmptyBorder(5, 2, 5, 2)
        );

        JPanel informacion = new JPanel(
                new GridLayout(2, 1)
        );

        informacion.setOpaque(false);

        // NOMBRE DEL PRODUCTO EN NEGRO Y NEGRITA
        JLabel nombreProducto =
                new JLabel(p.nombre);

        nombreProducto.setForeground(Color.BLACK);
        nombreProducto.setFont(
                new Font("Arial", Font.BOLD, 15)
        );

        // PRECIO Y CANTIDAD
        JLabel detalleProducto = new JLabel(
                cantidad + " x " +
                        monedaUSD.format(p.precioCentavos / 100.0)
                        + " = " +
                        monedaUSD.format(totalLinea / 100.0)
        );

        detalleProducto.setForeground(Color.BLACK);
        detalleProducto.setFont(
                new Font("Arial", Font.BOLD, 12)
        );

        informacion.add(nombreProducto);
        informacion.add(detalleProducto);

        // BOTONES DE CANTIDAD
        JPanel botones = new JPanel(
                new FlowLayout(FlowLayout.RIGHT, 3, 5)
        );

        botones.setOpaque(false);

        JButton menos = crearBoton("-", CAFE);
        JButton mas = crearBoton("+", VERDE);
        JButton quitar = crearBoton("X", ROJO);

        menos.addActionListener(
                e -> cambiarCantidad(p, -1)
        );

        mas.addActionListener(
                e -> cambiarCantidad(p, 1)
        );

        quitar.addActionListener(e -> {
            carrito.remove(p);
            actualizarCarrito();
        });

        botones.add(menos);
        botones.add(mas);
        botones.add(quitar);

        fila.add(informacion, BorderLayout.CENTER);
        fila.add(botones, BorderLayout.EAST);

        panelCarrito.add(fila);
        panelCarrito.add(new JSeparator());
    }

    totalActual = subtotal;

    lblUnidades.setText("Unidades: " + unidades);

    lblSubtotal.setText(
            "Subtotal: " +
                    monedaUSD.format(subtotal / 100.0)
    );

    lblTotal.setText(
            "TOTAL: " +
                    monedaUSD.format(subtotal / 100.0)
    );

    calcularCambio();

    panelCarrito.revalidate();
    panelCarrito.repaint();
    guardarDatos();
}

// ==========================================
// CAMBIAR CANTIDAD
// ==========================================

private void cambiarCantidad(
        Producto p,
        int cambio
) {

    int cantidad = carrito.getOrDefault(p, 0);
    int nuevaCantidad = cantidad + cambio;

    if (nuevaCantidad <= 0) {

        carrito.remove(p);

    } else if (nuevaCantidad <= p.stock) {

        carrito.put(p, nuevaCantidad);

    } else {

        JOptionPane.showMessageDialog(
                this,
                "No hay más unidades disponibles."
        );
    }

    actualizarCarrito();
}

// ==========================================
// CALCULAR CAMBIO
// ==========================================

private void calcularCambio() {

    if (txtRecibido == null || lblCambio == null) {
        return;
    }

    try {

        long recibido = convertirDinero(
                txtRecibido.getText()
        );

        long cambio = recibido - totalActual;

        lblCambio.setText(
                "Cambio: " +
                        monedaUSD.format(
                                Math.max(0, cambio) / 100.0
                        )
        );

    } catch (Exception e) {

        lblCambio.setText("Cambio: US$0.00");
    }
}

private long convertirDinero(String texto) {

    String limpio = texto
            .replace("$", "")
            .replace("US", "")
            .replace(",", "")
            .trim();

    if (limpio.isEmpty()) {
        return 0;
    }

    BigDecimal valor = new BigDecimal(limpio);

    return valor
            .multiply(new BigDecimal("100"))
            .longValueExact();
}


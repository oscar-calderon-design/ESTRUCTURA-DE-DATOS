// FACTURA
// ==========================================

private void mostrarFactura(
        String vendedor,
        long total,
        long recibido,
        long cambio
) {

    StringBuilder factura = new StringBuilder();

    factura.append("          COFFEESHOP\n");
    factura.append("--------------------------------\n");

    factura.append("Empleado: ")
            .append(vendedor).append("\n");
    if (pedidoEnAtencion != null) {
        factura.append("Cliente: ").append(pedidoEnAtencion.nombreCliente).append("\n");
        factura.append("Turno: ").append(pedidoEnAtencion.numeroTurno).append("\n");
    }
    factura.append("\n");

    factura.append("PRODUCTOS:\n");

    for (Map.Entry<Producto, Integer> entrada :
            carrito.entrySet()) {

        Producto p = entrada.getKey();
        int cantidad = entrada.getValue();

        factura.append(p.nombre)
                .append(" x ")
                .append(cantidad)
                .append(" = ")
                .append(monedaUSD.format(
                        p.precioCentavos * cantidad / 100.0
                ))
                .append("\n");
    }

    factura.append("--------------------------------\n");

    factura.append("TOTAL: ")
            .append(monedaUSD.format(total / 100.0))
            .append("\n");

    factura.append("RECIBIDO: ")
            .append(monedaUSD.format(recibido / 100.0))
            .append("\n");

    factura.append("CAMBIO: ")
            .append(monedaUSD.format(cambio / 100.0))
            .append("\n");

    factura.append("--------------------------------\n");
    factura.append("¡Gracias por tu compra!");

    JTextArea area = new JTextArea(
            factura.toString()
    );

    area.setEditable(false);
    area.setForeground(Color.BLACK);
    area.setBackground(Color.WHITE);

    area.setFont(
            new Font(Font.MONOSPACED, Font.BOLD, 13)
    );

    JOptionPane.showMessageDialog(
            this,
            new JScrollPane(area),
            "Factura de venta",
            JOptionPane.INFORMATION_MESSAGE
    );
}

// ==========================================
// ADMINISTRAR INVENTARIO
// ==========================================

private void administrarStock() {

    if (turnoFinalizado) return;

    String[] nombres = inventario.stream()
            .map(p -> p.nombre)
            .toArray(String[]::new);

    String seleccionado =
            (String) JOptionPane.showInputDialog(
                    this,
                    "Selecciona un producto:",
                    "Administrar inventario",
                    JOptionPane.QUESTION_MESSAGE,
                    null,
                    nombres,
                    nombres[0]
            );

    if (seleccionado == null) return;

    Producto producto = buscarProducto(seleccionado);

    if (producto == null) return;

    String cantidadTexto =
            JOptionPane.showInputDialog(
                    this,
                    "Stock actual: " + producto.stock +
                            "\n¿Cuántas unidades deseas agregar?"
            );

    if (cantidadTexto == null) return;

    try {

        int cantidad = Integer.parseInt(
                cantidadTexto.trim()
        );

        if (cantidad <= 0) {
            throw new NumberFormatException();
        }

        producto.stock += cantidad;
        guardarDatos();

        mostrarProductos();

        JOptionPane.showMessageDialog(
                this,
                "Inventario actualizado.\n" +
                        producto.nombre +
                        "\nNuevo stock: " + producto.stock
        );

    } catch (NumberFormatException e) {

        JOptionPane.showMessageDialog(
                this,
                "Ingresa una cantidad entera mayor que cero."
        );
    }
}

private Producto buscarProducto(String nombre) {

    for (Producto p : inventario) {

        if (p.nombre.equals(nombre)) {
            return p;
        }
    }

    return null;
}

// ==========================================
// SISTEMA DE LLEGADA Y ATENCION DE CLIENTES
// ==========================================

   
private void registrarLlegada() {

    if (turnoFinalizado) {
        JOptionPane.showMessageDialog(
                this,
                "El turno está finalizado. Inicia un nuevo turno para registrar clientes."
        );
        return;
    }

    String nombre = JOptionPane.showInputDialog(
            this,
            "Nombre del cliente:",
            "Registrar llegada",
            JOptionPane.QUESTION_MESSAGE
    );

    if (nombre == null) return;

    nombre = nombre.trim().replaceAll("\\s+", " ");

    if (nombre.isEmpty()) {
        JOptionPane.showMessageDialog(
                this,
                "Debes ingresar el nombre del cliente."
        );
        return;
    }

    String nombreNormalizado = normalizarNombreCliente(nombre);

    // Revisar únicamente los clientes que todavía están esperando.
    boolean estaEnCola = colaLlegada.stream()
            .anyMatch(p -> normalizarNombreCliente(
                    p.nombreCliente
            ).equals(nombreNormalizado));

    // Revisar si el cliente está siendo atendido actualmente.
    boolean estaEnAtencion = pedidoEnAtencion != null
            && normalizarNombreCliente(
                    pedidoEnAtencion.nombreCliente
            ).equals(nombreNormalizado);

    // Bloquear solamente si el pedido sigue activo.
    if (estaEnCola || estaEnAtencion) {
        JOptionPane.showMessageDialog(
                this,
                "Este cliente ya está esperando o está siendo atendido.",
                "Cliente duplicado",
                JOptionPane.WARNING_MESSAGE
        );
        return;
    }

    // Guardar el nombre como referencia histórica.
    // Este registro NO debe impedir futuras compras.
    clientesRegistrados.add(nombreNormalizado);

    int indice = aleatorio.nextInt(vendedores.length);
    String empleado = vendedores[indice];

    Pedido pedido = new Pedido(
            siguienteTurno++,
            nombre,
            empleado
    );

    colaLlegada.offer(pedido);

    guardarDatos();
    mostrarColaLlegada();
}

// Normaliza el nombre para detectar duplicados aunque cambien
// mayúsculas, tildes o espacios. Los nombres completos diferentes
// (por ejemplo, "Laura Sofia" y "Ana Sofia") se aceptan.
private String normalizarNombreCliente(String nombre) {
    String sinTildes = java.text.Normalizer.normalize(
            nombre.trim().replaceAll("\\s+", " "),
            java.text.Normalizer.Form.NFD
    ).replaceAll("\\p{M}+", "");
    return sinTildes.toLowerCase(Locale.ROOT);
}

private void atenderSiguiente() {
    if (turnoFinalizado) return;
    if (pedidoEnAtencion != null) {
        JOptionPane.showMessageDialog(this,
                "Primero termina o cancela el pedido que está en atención.");
        return;
    }
    Pedido siguiente = colaLlegada.poll();
    if (siguiente == null) {
        JOptionPane.showMessageDialog(this, "No hay clientes esperando.");
        return;
    }
    pedidoEnAtencion = siguiente;
    cmbVendedor.setSelectedItem(siguiente.empleadoAsignado);
    carrito.clear();
    txtRecibido.setText("");
    actualizarEtiquetaAtencion();
    actualizarCarrito();
    guardarDatos();
    JOptionPane.showMessageDialog(this,
            "Atendiendo turno: " + siguiente.numeroTurno +
                    "\nCliente: " + siguiente.nombreCliente +
                    "\nEmpleado asignado: " + siguiente.empleadoAsignado +
                    "\n\nAhora agrega los productos al pedido.");
}

private void actualizarEtiquetaAtencion() {
    if (lblPedidoAtencion == null) return;
    if (pedidoEnAtencion == null) {
        lblPedidoAtencion.setText("Sin cliente en atención");
    } else {
        lblPedidoAtencion.setText("Turno #" + pedidoEnAtencion.numeroTurno +
                " | " + pedidoEnAtencion.nombreCliente +
                " | " + pedidoEnAtencion.empleadoAsignado);
    }
}

private void mostrarColaLlegada() {
    StringBuilder texto = new StringBuilder("LISTA DE LLEGADA\n");
    texto.append("----------------------------------\n");
    if (colaLlegada.isEmpty()) texto.append("No hay clientes esperando.\n");
    for (Pedido p : colaLlegada) {
        texto.append("Turno #").append(p.numeroTurno)
                .append(" - ").append(p.nombreCliente)
                .append(" - Atiende: ").append(p.empleadoAsignado).append("\n");
    }
    if (pedidoEnAtencion != null) {
        texto.append("\nEN ATENCION: Turno #").append(pedidoEnAtencion.numeroTurno)
                .append(" - ").append(pedidoEnAtencion.nombreCliente)
                .append(" - ").append(pedidoEnAtencion.empleadoAsignado).append("\n");
    }
    JTextArea area = new JTextArea(texto.toString(), 15, 38);
    area.setEditable(false);
    area.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 13));
    JOptionPane.showMessageDialog(this, new JScrollPane(area),
            "Cola de llegada", JOptionPane.INFORMATION_MESSAGE);
}

private void buscarEmpleadoPorId() {
    String entrada = JOptionPane.showInputDialog(this,
            "Ingresa el ID del empleado:\n1001 - Stefan Salvatore\n1002 - Enzo\n1003 - Katherine Pierce",
            "Buscar empleado", JOptionPane.QUESTION_MESSAGE);
    if (entrada == null) return;
    try {
        int id = Integer.parseInt(entrada.trim());
        String nombre = empleadosPorId.get(id);
        if (nombre == null) {
            JOptionPane.showMessageDialog(this, "No existe un empleado con ID " + id);
            return;
        }
        String informacion = "ID: " + id + "\nEmpleado: " + nombre +
                "\nVentas realizadas: " + ventasPorVendedor.get(nombre) +
                "\nTotal vendido: " + monedaUSD.format(dineroPorVendedor.get(nombre) / 100.0);
        JOptionPane.showMessageDialog(this, informacion,
                "Datos del empleado", JOptionPane.INFORMATION_MESSAGE);
    } catch (NumberFormatException ex) {
        JOptionPane.showMessageDialog(this, "El ID debe ser un número entero.");
    }
}

// ==========================================
// GUARDAR Y RECUPERAR DATOS DEL SISTEMA
// ==========================================

private void guardarDatos() {
    File temporal = new File(CARPETA_DATOS, "coffeeshop_datos.tmp");
    try {
        if (!CARPETA_DATOS.exists() && !CARPETA_DATOS.mkdirs()) {
            throw new IOException("No se pudo crear la carpeta " + CARPETA_DATOS);
        }

        DatosSistema datos = new DatosSistema();
        datos.inventario = new ArrayList<>(inventario);
        datos.historial = new ArrayList<>(historial);
        datos.colaLlegada = new ArrayList<>(colaLlegada);
        datos.ventasPorVendedor = new LinkedHashMap<>(ventasPorVendedor);
        datos.dineroPorVendedor = new LinkedHashMap<>(dineroPorVendedor);
        datos.siguienteTurno = siguienteTurno;
        datos.pedidoEnAtencion = pedidoEnAtencion;
        datos.carrito = new LinkedHashMap<>(carrito);
        datos.turnoFinalizado = turnoFinalizado;
        datos.clientesRegistrados = new LinkedHashSet<>(clientesRegistrados);

        try (ObjectOutputStream salida = new ObjectOutputStream(
                new FileOutputStream(temporal))) {
            salida.writeObject(datos);
            salida.flush();
        }

        try {
            Files.move(temporal.toPath(), ARCHIVO_DATOS.toPath(),
                    StandardCopyOption.REPLACE_EXISTING,
                    StandardCopyOption.ATOMIC_MOVE);
        } catch (IOException ex) {
            Files.move(temporal.toPath(), ARCHIVO_DATOS.toPath(),
                    StandardCopyOption.REPLACE_EXISTING);
        }
    } catch (IOException ex) {
        temporal.delete();
        JOptionPane.showMessageDialog(this,
                "No se pudieron guardar los datos: " + ex.getMessage(),
                "Error al guardar", JOptionPane.ERROR_MESSAGE);
    }
}

private void cargarDatos() {
    // Compatibilidad: si existe el archivo antiguo junto al proyecto,
    // se usa para recuperar los datos por primera vez.
    File archivo = ARCHIVO_DATOS.exists()
            ? ARCHIVO_DATOS : new File("coffeeshop_datos.dat");
    if (!archivo.exists()) return;

    try (ObjectInputStream entrada = new ObjectInputStream(
            new FileInputStream(archivo))) {
        DatosSistema datos = (DatosSistema) entrada.readObject();

        if (datos.inventario != null) {
            inventario.clear();
            inventario.addAll(datos.inventario);
        }
        if (datos.historial != null) {
            historial.clear();
            historial.addAll(datos.historial);
        }
        if (datos.colaLlegada != null) {
            colaLlegada.clear();
            colaLlegada.addAll(datos.colaLlegada);
        }
        if (datos.ventasPorVendedor != null) {
            ventasPorVendedor.clear();
            ventasPorVendedor.putAll(datos.ventasPorVendedor);
        }
        if (datos.dineroPorVendedor != null) {
            dineroPorVendedor.clear();
            dineroPorVendedor.putAll(datos.dineroPorVendedor);
        }

        siguienteTurno = Math.max(1, datos.siguienteTurno);
        pedidoEnAtencion = datos.pedidoEnAtencion;
        carrito.clear();
        if (datos.carrito != null) {
            carrito.putAll(datos.carrito);
        }
        turnoFinalizado = datos.turnoFinalizado;

        // Recuperar clientes. Si el archivo es de una versión anterior,
        // reconstruir el registro usando los clientes ya guardados.
        clientesRegistrados.clear();
        if (datos.clientesRegistrados != null) {
            clientesRegistrados.addAll(datos.clientesRegistrados);
        }
        for (Venta venta : historial) {
            if (venta.cliente != null && !venta.cliente.trim().isEmpty()) {
                clientesRegistrados.add(normalizarNombreCliente(venta.cliente));
            }
        }
        for (Pedido pedido : colaLlegada) {
            if (pedido.nombreCliente != null && !pedido.nombreCliente.trim().isEmpty()) {
                clientesRegistrados.add(normalizarNombreCliente(pedido.nombreCliente));
            }
        }
        if (pedidoEnAtencion != null && pedidoEnAtencion.nombreCliente != null
                && !pedidoEnAtencion.nombreCliente.trim().isEmpty()) {
            clientesRegistrados.add(normalizarNombreCliente(pedidoEnAtencion.nombreCliente));
        }

        // Asegurar que vendedores nuevos o faltantes tengan estadísticas.
        for (String vendedor : vendedores) {
            ventasPorVendedor.putIfAbsent(vendedor, 0);
            dineroPorVendedor.putIfAbsent(vendedor, 0L);
        }
    } catch (IOException | ClassNotFoundException | ClassCastException ex) {
        JOptionPane.showMessageDialog(this,
                "No se pudieron recuperar los datos guardados: " + ex.getMessage()
                        + "\\nEl archivo se conserva para no perder la información.",
                "Error al cargar", JOptionPane.ERROR_MESSAGE);
    }
}

// Reconstruye el reporte desde el historial guardado. Así el Excel
// también conserva las ventas anteriores y nunca duplica filas al abrir.
private void reconstruirReporteCSV() {
    try {
        if (!CARPETA_DATOS.exists() && !CARPETA_DATOS.mkdirs()) {
            throw new IOException("No se pudo crear la carpeta de reportes.");
        }
        Files.deleteIfExists(ARCHIVO_VENTAS.toPath());

        int consecutivo = 1;
        for (Venta venta : historial) {
            if (venta.numeroFactura <= 0) {
                venta.numeroFactura = consecutivo;
            }
            if (venta.fecha == null) {
                venta.fecha = "";
            }
            if (venta.cliente == null) {
                venta.cliente = "";
            }
            exportarVentaCSV(venta);
            consecutivo++;
        }
    } catch (IOException ex) {
        JOptionPane.showMessageDialog(this,
                "No se pudo reconstruir el reporte de Excel: " + ex.getMessage(),
                "Aviso de reporte", JOptionPane.WARNING_MESSAGE);
    }
}

// Registra cada producto vendido en un CSV que Excel puede abrir.
// Se escribe una fila por producto para que el reporte pueda filtrarse.
private void exportarVentaCSV(Venta venta) throws IOException {
    if (!CARPETA_DATOS.exists() && !CARPETA_DATOS.mkdirs()) {
        throw new IOException("No se pudo crear la carpeta de reportes.");
    }

    boolean escribirEncabezado =
            !ARCHIVO_VENTAS.exists() || ARCHIVO_VENTAS.length() == 0;

    try (BufferedWriter writer = Files.newBufferedWriter(
            ARCHIVO_VENTAS.toPath(), StandardCharsets.UTF_8,
            java.nio.file.StandardOpenOption.CREATE,
            java.nio.file.StandardOpenOption.APPEND)) {

        if (escribirEncabezado) {
            writer.write(0xFEFF); // Excel reconoce correctamente tildes y ñ.
            writer.write("Fecha;Factura;Vendedor;Cliente;Producto;Cantidad;"
                    + "Precio unitario;Subtotal producto;Total factura;Recibido;Cambio");
            writer.newLine();
        }

        String cliente = venta.cliente == null ? "" : venta.cliente;
        for (Map.Entry<Producto, Integer> item : venta.detalle.entrySet()) {
            Producto producto = item.getKey();
            int cantidad = item.getValue();
            long subtotalLinea = producto.precioCentavos * cantidad;

            String[] columnas = {
                    venta.fecha,
                    String.valueOf(venta.numeroFactura),
                    venta.vendedor,
                    cliente,
                    producto.nombre,
                    String.valueOf(cantidad),
                    formatoCSVdinero(producto.precioCentavos),
                    formatoCSVdinero(subtotalLinea),
                    formatoCSVdinero(venta.totalCentavos),
                    formatoCSVdinero(venta.recibidoCentavos),
                    formatoCSVdinero(venta.cambioCentavos)
            };

            for (int i = 0; i < columnas.length; i++) {
                if (i > 0) writer.write(";");
                writer.write(escaparCSV(columnas[i]));
            }
            writer.newLine();
        }
    }
}

private String formatoCSVdinero(long centavos) {
    return String.format(Locale.US, "%.2f", centavos / 100.0);
}

private String escaparCSV(String valor) {
    if (valor == null) return "";
    return "\"" + valor.replace("\"", "\"\"") + "\"";
}

// Guarda una factura individual en formato TXT, además de mostrarla.
private void guardarFacturaTexto(Venta venta) {
    try {
        if (!CARPETA_FACTURAS.exists() && !CARPETA_FACTURAS.mkdirs()) {
            throw new IOException("No se pudo crear la carpeta de facturas.");
        }

        String nombreArchivo = String.format(Locale.ROOT,
                "factura_%06d.txt", venta.numeroFactura);
        File archivo = new File(CARPETA_FACTURAS, nombreArchivo);

        StringBuilder texto = new StringBuilder();
        texto.append("                 COFFEESHOP\\n");
        texto.append("FACTURA No.: ").append(venta.numeroFactura).append("\\n");
        texto.append("Fecha: ").append(venta.fecha).append("\\n");
        texto.append("Empleado: ").append(venta.vendedor).append("\\n");
        if (venta.cliente != null && !venta.cliente.isEmpty()) {
            texto.append("Cliente: ").append(venta.cliente).append("\\n");
        }
        texto.append("------------------------------------------\\n");
        texto.append("PRODUCTO       CANT.       SUBTOTAL\\n");
        for (Map.Entry<Producto, Integer> item : venta.detalle.entrySet()) {
            Producto producto = item.getKey();
            int cantidad = item.getValue();
            texto.append(producto.nombre).append(" x ")
                    .append(cantidad).append("       ")
                    .append(monedaUSD.format(
                            producto.precioCentavos * cantidad / 100.0))
                    .append("\\n");
        }
        texto.append("------------------------------------------\\n");
        texto.append("TOTAL: ").append(monedaUSD.format(
                venta.totalCentavos / 100.0)).append("\\n");
        texto.append("RECIBIDO: ").append(monedaUSD.format(
                venta.recibidoCentavos / 100.0)).append("\\n");
        texto.append("CAMBIO: ").append(monedaUSD.format(
                venta.cambioCentavos / 100.0)).append("\\n");
        texto.append("------------------------------------------\\n");
        texto.append("          ¡Gracias por tu compra!\\n");

        Files.write(archivo.toPath(), texto.toString().getBytes(StandardCharsets.UTF_8));

        // Una hoja CSV individual por venta, que Excel puede abrir.
        File archivoCSV = new File(CARPETA_FACTURAS,
                String.format(Locale.ROOT, "venta_%06d.csv", venta.numeroFactura));
        try (BufferedWriter writer = Files.newBufferedWriter(
                archivoCSV.toPath(), StandardCharsets.UTF_8)) {
            writer.write(0xFEFF);
            writer.write("Fecha;Factura;Vendedor;Cliente;Producto;Cantidad;"
                    + "Precio unitario;Subtotal producto;Total factura;Recibido;Cambio");
            writer.newLine();

            for (Map.Entry<Producto, Integer> item : venta.detalle.entrySet()) {
                Producto producto = item.getKey();
                int cantidad = item.getValue();
                String[] columnas = {
                        venta.fecha,
                        String.valueOf(venta.numeroFactura),
                        venta.vendedor,
                        venta.cliente == null ? "" : venta.cliente,
                        producto.nombre,
                        String.valueOf(cantidad),
                        formatoCSVdinero(producto.precioCentavos),
                        formatoCSVdinero(producto.precioCentavos * cantidad),
                        formatoCSVdinero(venta.totalCentavos),
                        formatoCSVdinero(venta.recibidoCentavos),
                        formatoCSVdinero(venta.cambioCentavos)
                };
                for (int i = 0; i < columnas.length; i++) {
                    if (i > 0) writer.write(";");
                    writer.write(escaparCSV(columnas[i]));
                }
                writer.newLine();
            }
        }
    } catch (IOException ex) {
        JOptionPane.showMessageDialog(this,
                "La venta se registró, pero no se pudo crear el archivo de factura: "
                        + ex.getMessage(),
                "Aviso de factura", JOptionPane.WARNING_MESSAGE);
    }
}

